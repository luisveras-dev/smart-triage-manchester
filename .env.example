# ==============================================================================
# Configurações de Ambiente - Smart Triage Manchester
# ==============================================================================
# Obtenha sua chave gratuita da API do Gemini em: https://aistudio.google.com/app/apikey
# Para usar, copie este arquivo para .env (o arquivo .env é ignorado pelo git):
#   cp .env.example .env
# E insira sua chave abaixo:
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo padrão do Google Gemini
GEMINI_MODEL=gemini-2.5-flash
